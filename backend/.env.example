# Copy to backend/.env for local development. Never commit the real file.

# --- Required ---

# MongoDB connection string (Atlas, or a local mongod).
MONGO_URI=mongodb://127.0.0.1:27017/filiphagen

# Anthropic API key. SERVER-SIDE ONLY — this must never appear in anything
# under frontend/, and fitness function f2 fails the build if it does.
ANTHROPIC_API_KEY=

# --- Recommended in production ---

# Origin of the static site that serves the SPA, so CORS admits it.
# Since ADR 0001 the frontend is on a different origin from this API, so
# without this the browser blocks every chat request.
# e.g. https://filiphagen-web.onrender.com
STATIC_SITE_URL=

# Port. Render sets this automatically; default 4000 locally.
PORT=4000

# --- Abuse guard (ADR 0002). All optional; defaults shown. ---

# Hard ceiling on tokens spent per UTC day. Once reached, /api/chat returns
# 429 until midnight UTC. This is the number that bounds your bill — the
# whole guard exists to make worst-case spend something you choose.
# 300000 tokens is roughly $4.50/day worst case.
CHAT_DAILY_TOKEN_CEILING=300000

# Requests per IP per window before 429.
CHAT_RATE_LIMIT_MAX=20

# Rate limit window in ms (default 24h).
CHAT_RATE_LIMIT_WINDOW_MS=86400000

# Max request body size for the chat route.
CHAT_BODY_LIMIT=16kb

# Max messages allowed in one conversation payload.
CHAT_MAX_MESSAGES=40
