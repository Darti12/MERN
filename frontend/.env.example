# Absolute origin of the Chat API — the SPA is served from a static host on a
# different origin (ADR 0001), so this cannot be inferred and must be set at
# build time. No trailing slash needed.
#
# Local development:  http://localhost:4000
# Production:         https://<your-api-service>.onrender.com
REACT_APP_API_URL=http://localhost:4000

# NOTE: never put ANTHROPIC_API_KEY (or any secret) in this file or any other
# file under frontend/. Anything reachable from the frontend build is public.
# It belongs in the API service's environment only. See ADR 0002.
